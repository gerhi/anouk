Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.sample\.php|install\.lock|.*\.sql|.*\.md|.*\.cff|composer\.json|LICENSE)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
